{
  "name": "writer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:resources": "bun run scripts/prepare-resources.ts",
    "build:bundle": "bun run build && bun run build:resources",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dmg": "tauri build --bundles dmg",
    "release:macos": "bash scripts/release-macos.sh",
    "install:app": "tauri build --bundles app && rm -rf /Applications/Writer.app && cp -R src-tauri/target/release/bundle/macos/Writer.app /Applications/Writer.app"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8",
    "@codemirror/lang-css": "^6.3",
    "@codemirror/lang-html": "^6.4",
    "@codemirror/lang-javascript": "^6.2",
    "@codemirror/lang-json": "^6.0",
    "@codemirror/lang-markdown": "^6.3",
    "@codemirror/lang-python": "^6.1",
    "@codemirror/lang-rust": "^6.0",
    "@codemirror/lang-yaml": "^6.1",
    "@codemirror/language": "^6.11",
    "@codemirror/state": "^6.5",
    "@codemirror/view": "^6.36",
    "@lezer/common": "^1.2",
    "@lezer/highlight": "^1.2",
    "@lezer/markdown": "^1.4",
    "@mdx-js/mdx": "^3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "katex": "^0.16",
    "lucide-react": "^0.487",
    "react": "^19",
    "react-dom": "^19",
    "rehype-katex": "^7.0",
    "rehype-slug": "^6.0",
    "remark-gfm": "^4.0",
    "remark-math": "^6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5.8",
    "vite": "^6"
  }
}
