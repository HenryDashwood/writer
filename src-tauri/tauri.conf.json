{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writer",
  "version": "0.1.0",
  "identifier": "com.henrydashwood.writer",
  "build": {
    "beforeDevCommand": "bun run build:resources && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Writer",
        "width": 1200,
        "height": 820,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFOEM5MUE2Q0I0MzAzRTkKUldUcEEwUExwcEdNM2tseFNIL3c5dkZ0U1pLSkp0cHRQeENTV2Z5QWhKa0JFNU14Zy9PWmdZcWMK",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/HenryDashwood/writer/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["resources/writer-mdx"],
    "resources": {
      "resources/sidecar": "sidecar",
      "resources/skills": "skills"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
